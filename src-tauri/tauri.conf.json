{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "mundravax",
  "version": "0.1.0",
  "identifier": "dev.mundravax.app",
  "build": {
    "frontendDist": "../demo/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run demo:start",
    "beforeBuildCommand": "pnpm run demo:build"
  },
  "app": {
    "windows": [
      {
        "title": "Mundravax",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
